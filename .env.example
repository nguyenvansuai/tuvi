# Sao chép thành .env rồi điền giá trị thật:  cp .env.example .env

# ─── AI luận giải (FreeLLMAPI của Sự AI, chuẩn OpenAI) ───
FREELLM_BASE_URL=https://freellmapi.suai.vn
FREELLM_API_KEY=dien-api-key-cua-ban
# "auto" = để router tự chọn model; có thể ghi tên model cụ thể
FREELLM_MODEL=auto

# ─── Website ───
# Dùng khi build (sitemap, canonical, ảnh chia sẻ) — đổi xong phải build lại
NEXT_PUBLIC_SITE_URL=https://tuvi.suai.vn

# Cổng nội bộ trên VPS (nginx proxy vào đây)
APP_PORT=3020
